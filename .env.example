# Copy to .env and fill in (all optional; app works without them using demo data)
OPENFDA_API_KEY=        # free: https://open.fda.gov/apis/authentication/
NCBI_API_KEY=           # free: NCBI account settings
ANTHROPIC_API_KEY=      # optional: better free-text symptom mapping; falls back to keywords
LLM_MODEL=claude-sonnet-5-5
HASH_SALT=put-a-random-string-here
